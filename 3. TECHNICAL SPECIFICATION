class MOESI_Protocol:
    def __init__(self):
        self.cache_states = {}  # address -> (state, data, sharers)
        self.directory = DirectoryController()
        
    def read_request(self, address, requester):
        """Handle read request."""
        state = self.get_state(address)
        
        if state == 'M' or state == 'O' or state == 'E' or state == 'S':
            # Data available locally or from another cache
            if state == 'M':
                # Transition M->O if sharing
                self.set_state(address, 'O')
                self.add_sharer(address, requester)
            elif state == 'E':
                # Transition E->S
                self.set_state(address, 'S')
                self.add_sharer(address, requester)
            elif state == 'S' or state == 'O':
                # Add to sharers list
                self.add_sharer(address, requester)
            
            # Provide data
            data = self.get_data(address)
            return data
            
        else:  # state == 'I'
            # Fetch from memory or other cache
            data = self.fetch_from_memory(address)
            self.set_state(address, 'E' if exclusive else 'S')
            self.set_data(address, data)
            self.add_sharer(address, requester)
            return data
    
    def write_request(self, address, data, requester):
        """Handle write request."""
        state = self.get_state(address)
        sharers = self.get_sharers(address)
        
        if requester in sharers:
            if state == 'M':
                # Already exclusive dirty, just update
                self.set_data(address, data)
            elif state == 'O' or state == 'E' or state == 'S':
                # Invalidate other sharers
                for sharer in sharers:
                    if sharer != requester:
                        self.invalidate(sharer, address)
                
                # Transition to M
                self.set_state(address, 'M')
                self.set_data(address, data)
                self.set_sharers(address, [requester])
        else:
            # Fetch and invalidate others
            self.fetch_from_memory(address)
            self.invalidate_all(address)
            
            # Transition to M
            self.set_state(address, 'M')
            self.set_data(address, data)
            self.set_sharers(address, [requester])
