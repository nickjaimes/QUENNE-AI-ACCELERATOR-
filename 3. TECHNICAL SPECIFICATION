L1 Cache Structure:

```python
class L1Cache:
    def __init__(self, size_mb=16, associativity=8, line_size=64):
        self.size_bytes = size_mb * 1024 * 1024
        self.associativity = associativity
        self.line_size = line_size
        
        # Calculate parameters
        self.num_sets = self.size_bytes // (associativity * line_size)
        self.index_bits = int(math.log2(self.num_sets))
        self.offset_bits = int(math.log2(line_size))
        self.tag_bits = 48 - self.index_bits - self.offset_bits
        
        # Cache array
        self.tags = np.zeros((self.num_sets, associativity), dtype=np.uint64)
        self.data = np.zeros((self.num_sets, associativity, line_size), dtype=np.uint8)
        self.states = np.zeros((self.num_sets, associativity), dtype=np.uint8)  # MOESI states
        self.lru = np.zeros((self.num_sets, associativity), dtype=np.uint8)
        
    def access(self, address, is_write=False):
        """Access cache."""
        # Extract fields
        tag = (address >> (self.index_bits + self.offset_bits)) & ((1 << self.tag_bits) - 1)
        index = (address >> self.offset_bits) & ((1 << self.index_bits) - 1)
        offset = address & ((1 << self.offset_bits) - 1)
        
        # Check for hit
        for way in range(self.associativity):
            if self.tags[index, way] == tag and self.states[index, way] != 'I':
                # Hit
                self.update_lru(index, way)
                data = self.data[index, way, offset:offset+8]  # Assuming 8-byte access
                return True, data, self.states[index, way]
        
        # Miss
        return False, None, 'I'
    
    def update_lru(self, index, way):
        """Update LRU counters."""
        for w in range(self.associativity):
            if self.lru[index, w] < self.lru[index, way]:
                self.lru[index, w] += 1
        self.lru[index, way] = 0
```

