class SparseMatrixEngine:
    def __init__(self):
        self.format_detector = FormatDetector()
        self.decoder = SparseDecoder()
        self.compute_units = SparseComputeArray()
        
    def spmm(self, sparse_matrix, dense_matrix):
        """Sparse-dense matrix multiplication."""
        # Auto-detect format
        format_info = self.format_detector.detect(sparse_matrix)
        
        # Decode sparse matrix
        decoded = self.decoder.decode(sparse_matrix, format_info)
        
        # Perform multiplication
        # Each non-zero multiplies corresponding row of dense matrix
        result = np.zeros((sparse_matrix.shape[0], dense_matrix.shape[1]))
        
        for i, j, val in decoded.nonzeros():
            result[i, :] += val * dense_matrix[j, :]
        
        return result
    
    def efficiency(self, sparsity):
        """Compute efficiency at given sparsity level."""
        if sparsity < 0.5:
            return 0.2  # Low efficiency for dense matrices
        elif sparsity < 0.9:
            return 0.5  # Moderate efficiency
        elif sparsity < 0.95:
            return 0.8  # Good efficiency
