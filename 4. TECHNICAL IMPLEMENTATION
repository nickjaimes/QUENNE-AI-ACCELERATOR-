2.2.2 Chiplet Power Management

```systemverilog
// Chiplet power management implementation
module chiplet_power_management #(
    parameter NUM_VOLTAGE_RAILS = 4,
    parameter NUM_CLOCK_DOMAINS = 3,
    parameter NUM_POWER_STATES = 8
)(
    input  logic                        clk,
    input  logic                        rst_n,
    
    // Power control interface
    power_control_if.slave              pwr_ctrl_if,
    
    // Voltage monitoring
    input  logic [11:0]                 voltage_mon [NUM_VOLTAGE_RAILS-1:0],
    input  logic [11:0]                 current_mon [NUM_VOLTAGE_RAILS-1:0],
    
    // Temperature monitoring
    input  logic [11:0]                 temp_mon,
    
    // Control outputs
    output logic [7:0]                  voltage_set [NUM_VOLTAGE_RAILS-1:0],
    output logic [7:0]                  current_limit [NUM_VOLTAGE_RAILS-1:0],
    output logic [2:0]                  clock_div [NUM_CLOCK_DOMAINS-1:0],
    output logic                        clock_gate [NUM_CLOCK_DOMAINS-1:0],
    
    // Status outputs
    output logic [1:0]                  power_state,
    output logic                        power_good,
    output logic [3:0]                  fault_status
);

    // Power state machine
    enum logic [2:0] {
        POWER_OFF,
        POWER_ON_SEQ,
        POWER_ON,
        POWER_LOW,
        POWER_HIGH,
        POWER_OFF_SEQ,
        POWER_FAULT,
        POWER_RECOVERY
    } power_state_reg, power_state_next;
    
    // Power sequencing timer
    logic [23:0] power_seq_timer;
    logic        power_seq_timeout;
    
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            power_state_reg <= POWER_OFF;
            power_seq_timer <= 24'h0;
        end else begin
            power_state_reg <= power_state_next;
            
            if (power_seq_start) begin
                power_seq_timer <= 24'h0;
            end else if (power_seq_active) begin
                power_seq_timer <= power_seq_timer + 1;
            end
        end
    end
    
    always_comb begin
        power_state_next = power_state_reg;
        power_seq_start = 1'b0;
        power_seq_active = 1'b0;
        power_seq_timeout = (power_seq_timer == 24'hFFFFFF);
        
        case (power_state_reg)
            POWER_OFF: begin
                if (pwr_ctrl_if.power_on) begin
                    power_state_next = POWER_ON_SEQ;
                    power_seq_start = 1'b1;
                end
            end
            
            POWER_ON_SEQ: begin
                power_seq_active = 1'b1;
                
                // Sequence: 3.3V -> 1.8V -> 1.0V -> 0.85V
                if (power_seq_timer < 24'h0000FF) begin
                    // Enable 3.3V
                    voltage_set[0] = 8'hFF;  // 3.3V
                end else if (power_seq_timer < 24'h0001FF) begin
                    // Enable 1.8V
                    voltage_set[1] = 8'hB4;  // 1.8V
                end else if (power_seq_timer < 24'h0002FF) begin
                    // Enable 1.0V
                    voltage_set[2] = 8'h64;  // 1.0V
                end else if (power_seq_timer < 24'h0003FF) begin
                    // Enable 0.85V
                    voltage_set[3] = 8'h55;  // 0.85V
                end else if (power_seq_timer >= 24'h0003FF) begin
                    // Check all power good
                    if (voltage_good) begin
                        power_state_next = POWER_ON;
                    end else if (power_seq_timeout) begin
                        power_state_next = POWER_FAULT;
                    end
                end
            end
            
            POWER_ON: begin
                if (pwr_ctrl_if.power_off) begin
                    power_state_next = POWER_OFF_SEQ;
                    power_seq_start = 1'b1;
                end else if (pwr_ctrl_if.power_low) begin
                    power_state_next = POWER_LOW;
                end else if (pwr_ctrl_if.power_high) begin
                    power_state_next = POWER_HIGH;
                end else if (fault_detected) begin
                    power_state_next = POWER_FAULT;
                end
            end
            
            POWER_LOW: begin
                // Low power mode: reduce voltage and frequency
                voltage_set[3] = 8'h4A;  // 0.75V
                clock_div[0] = 3'h3;     // Divide by 8
                
                if (pwr_ctrl_if.power_on) begin
                    power_state_next = POWER_ON;
                end else if (fault_detected) begin
                    power_state_next = POWER_FAULT;
                end
            end
            
            POWER_HIGH: begin
                // High performance mode: increase voltage
                voltage_set[3] = 8'h60;  // 0.95V
                clock_gate = '0;         // All clocks active
                
                if (pwr_ctrl_if.power_on) begin
                    power_state_next = POWER_ON;
                end else if (fault_detected) begin
                    power_state_next = POWER_FAULT;
                end
            end
            
            POWER_OFF_SEQ: begin
                power_seq_active = 1'b1;
                
                // Reverse sequence: 0.85V -> 1.0V -> 1.8V -> 3.3V
                if (power_seq_timer < 24'h0000FF) begin
                    // Disable 0.85V
                    voltage_set[3] = 8'h00;
                end else if (power_seq_timer < 24'h0001FF) begin
                    // Disable 1.0V
                    voltage_set[2] = 8'h00;
                end else if (power_seq_timer < 24'h0002FF) begin
                    // Disable 1.8V
                    voltage_set[1] = 8'h00;
                end else if (power_seq_timer < 24'h0003FF) begin
                    // Disable 3.3V
                    voltage_set[0] = 8'h00;
                end else if (power_seq_timer >= 24'h0003FF) begin
                    power_state_next = POWER_OFF;
                end
            end
            
            POWER_FAULT: begin
                // Enter fault state
                fault_status = fault_code;
                
                if (pwr_ctrl_if.power_recovery) begin
                    power_state_next = POWER_RECOVERY;
                    power_seq_start = 1'b1;
                end
            end
            
            POWER_RECOVERY: begin
                power_seq_active = 1'b1;
                
                // Attempt recovery sequence
                if (power_seq_timer < 24'h000FFF) begin
                    // Power cycle
                    voltage_set = '{default: '0};
                end else if (power_seq_timer < 24'h001FFF) begin
                    // Re-apply power sequence
                    // Similar to POWER_ON_SEQ but with monitoring
                end else if (recovery_successful) begin
                    power_state_next = POWER_ON;
                end else if (power_seq_timeout) begin
                    power_state_next = POWER_OFF;
                end
            end
        endcase
    end
    
    // Voltage monitoring and fault detection
    generate
        for (genvar i = 0; i < NUM_VOLTAGE_RAILS; i++) begin : voltage_monitor
            voltage_fault_detector #(
                .MIN_VOLTAGE(12'h000),
                .MAX_VOLTAGE(12'hFFF),
                .HYSTERESIS(12'h010)
            ) u_volt_fault (
                .clk(clk),
                .rst_n(rst_n),
                
                .voltage_in(voltage_mon[i]),
                .voltage_set(voltage_set[i]),
                
                .voltage_good(voltage_good[i]),
                .fault_undervolt(fault_undervolt[i]),
                .fault_overvolt(fault_overvolt[i])
            );
        end
    endgenerate
    
    // Current monitoring
    generate
        for (genvar i = 0; i < NUM_VOLTAGE_RAILS; i++) begin : current_monitor
            current_fault_detector #(
                .CURRENT_LIMIT(12'h100)
            ) u_curr_fault (
                .clk(clk),
                .rst_n(rst_n),
                
                .current_in(current_mon[i]),
                .current_limit(current_limit[i]),
                
                .fault_overcurrent(fault_overcurrent[i])
            );
        end
    endgenerate
    
    // Temperature monitoring
    temperature_fault_detector #(
        .TEMP_LIMIT(12'h200),  // 85°C
        .TEMP_HYSTERESIS(12'h010)
    ) u_temp_fault (
        .clk(clk),
        .rst_n(rst_n),
        
        .temp_in(temp_mon),
        
        .fault_overtemp(fault_overtemp),
        .temp_warning(temp_warning)
    );
    
    // Clock management
    clock_manager #(
        .NUM_DOMAINS(NUM_CLOCK_DOMAINS)
    ) u_clk_mgr (
        .clk(clk),
        .rst_n(rst_n),
        
        .power_state(power_state_reg),
        .clock_div(clock_div),
        .clock_gate(clock_gate),
        
        .clock_enable(clock_enable)
    );
    
    // Fault aggregation
    always_comb begin
        fault_detected = |{fault_undervolt, fault_overvolt, 
                          fault_overcurrent, fault_overtemp};
        
        if (fault_overtemp) begin
            fault_code = 4'h1;
        end else if (|fault_overcurrent) begin
            fault_code = 4'h2;
        end else if (|fault_overvolt) begin
            fault_code = 4'h3;
        end else if (|fault_undervolt) begin
            fault_code = 4'h4;
        end else begin
            fault_code = 4'h0;
        end
    end
    
    // Output assignments
    assign power_state = power_state_reg[1:0];
    assign power_good = (power_state_reg == POWER_ON) || 
                       (power_state_reg == POWER_LOW) || 
                       (power_state_reg == POWER_HIGH);
    
    // Performance counters
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            power_on_time <= 64'h0;
            active_time <= 64'h0;
            low_power_time <= 64'h0;
        end else begin
            if (power_state_reg != POWER_OFF) begin
                power_on_time <= power_on_time + 1;
            end
            
            if (power_state_reg == POWER_ON || 
                power_state_reg == POWER_HIGH) begin
                active_time <= active_time + 1;
            end
            
            if (power_state_reg == POWER_LOW) begin
                low_power_time <= low_power_time + 1;
            end
        end
    end

endmodule
