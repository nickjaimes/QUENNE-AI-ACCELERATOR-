    endgenerate
    
    // Host interface
    pcie_gen6_controller #(
        .LANES(PCIE_LANES),
        .MAX_PAYLOAD(512),
        .MAX_READ_REQ(4096)
    ) u_pcie (
        .clk(sys_clk),
        .rst_n(sys_rst_n),
        .rx_p(pcie_rx_p),
        .rx_n(pcie_rx_n),
