module quenne_ai_accelerator_top #(
    parameter CHIPLET_COUNT = 3,
    parameter HBM_CHANNELS = 4,
    parameter PCIE_LANES = 16
)(
    // Clock and reset
    input  wire         clk_400mhz,
    input  wire         clk_200mhz,
    input  wire         rst_n,
    
    // PCIe Gen6 interface
    input  wire [PCIE_LANES-1:0] pcie_rx_p,
    input  wire [PCIE_LANES-1:0] pcie_rx_n,
    output wire [PCIE_LANES-1:0] pcie_tx_p,
    output wire [PCIE_LANES-1:0] pcie_tx_n,
    
    // HBM3 interfaces
    inout  wire [1023:0] hbm_dq [HBM_CHANNELS-1:0],
    output wire [15:0]   hbm_addr [HBM_CHANNELS-1:0],
    output wire [1:0]    hbm_ba [HBM_CHANNELS-1:0],
    output wire [0:0]    hbm_cke [HBM_CHANNELS-1:0],
    output wire [0:0]    hbm_cs_n [HBM_CHANNELS-1:0],
    
