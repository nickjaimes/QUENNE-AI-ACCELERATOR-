        .refclk(clk_400mhz),
        .rst_n(rst_n),
        .sys_clk(sys_clk),
        .noc_clk(noc_clk),
        .mem_clk(mem_clk),
        .quantum_clk(quantum_clk),
        .neuro_clk(neuro_clk),
        .pll_lock(pll_lock)
    );
    
    // Reset synchronization
    reset_controller u_reset_ctrl (
        .clk(sys_clk),
        .rst_n(rst_n),
        .pll_lock(pll_lock),
        .sys_rst_n(sys_rst_n),
        .mem_rst_n(mem_rst_n),
        .quantum_rst_n(quantum_rst_n),
        .neuro_rst_n(neuro_rst_n),
        .tpu_rst_n(tpu_rst_n)
    );
    
    // Unified memory controller
    unified_memory_controller #(
        .CHANNELS(HBM_CHANNELS),
        .DATA_WIDTH(1024),
        .ADDR_WIDTH(34)
    ) u_umc (
        .clk(mem_clk),
        .rst_n(mem_rst_n),
        .hbm_dq(hbm_dq),
        .hbm_addr(hbm_addr),
        .hbm_ba(hbm_ba),
        .hbm_cke(hbm_cke),
        .hbm_cs_n(hbm_cs_n),
        .cpu_req(cpu_req),
        .cpu_resp(cpu_resp),
        .quantum_req(quantum_req),
        .quantum_resp(quantum_resp),
        .neuro_req(neuro_req),
        .neuro_resp(neuro_resp),
        .tpu_req(tpu_req),
        .tpu_resp(tpu_resp)
    );
    
    // Network-on-Chip
    network_on_chip #(
        .NODES(67),
        .DATA_WIDTH(256),
        .VC_COUNT(4)
    ) u_noc (
        .clk(noc_clk),
        .rst_n(sys_rst_n),
        .node_in(node_in),
        .node_out(node_out),
        .congestion(congestion),
        .qos(qos_levels)
    );
    
    // Chiplet instances
    generate
        genvar i;
        for (i = 0; i < CHIPLET_COUNT; i = i + 1) begin : chiplets
            case (i)
                0: begin  // Quantum chiplet
                    quantum_chiplet u_quantum (
                        .clk(quantum_clk),
                        .rst_n(quantum_rst_n),
                        .noc_in(node_out[0]),
                        .noc_out(node_in[0]),
                        .qubit_ctrl(qubit_control),
                        .qubit_rd(qubit_readout),
                        .mem_req(quantum_req),
                        .mem_resp(quantum_resp),
                        .calibration_en(calibration_en)
                    );
                end
                
                1: begin  // Neuromorphic chiplet
                    neuromorphic_chiplet u_neuro (
                        .clk(neuro_clk),
                        .rst_n(neuro_rst_n),
                        .noc_in(node_out[1]),
                        .noc_out(node_in[1]),
                        .spike_in(spike_inputs),
                        .spike_out(spike_outputs),
                        .mem_req(neuro_req),
                        .mem_resp(neuro_resp),
                        .learning_en(learning_en)
                    );
                end
                
                2: begin  // Tensor chiplet
                    tensor_chiplet #(
                        .TPU_CORES(64),
                        .ARRAY_SIZE(128)
                    ) u_tpu (
                        .clk(sys_clk),
                        .rst_n(tpu_rst_n),
                        .noc_in(node_out[2]),
                        .noc_out(node_in[2]),
                        .mem_req(tpu_req),
                        .mem_resp(tpu_resp),
                        .precision_sel(precision_sel)
                    );
                end
            endcase
