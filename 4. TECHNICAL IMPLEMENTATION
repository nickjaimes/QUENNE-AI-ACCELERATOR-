        for risk_id, risk in self.risks.items():
            if risk['score'] >= risk['threshold']:
                mitigation = self.mitigations[risk_id]
                
                if not mitigation['active']:
                    self.activate_mitigation(mitigation)
                    
                    # Log mitigation action
                    self.log_mitigation_action(
                        risk_id=risk_id,
                        action=mitigation['action'],
                        expected_outcome=mitigation['expected_outcome']
                    )
