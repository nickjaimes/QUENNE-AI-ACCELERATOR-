1.4.2 Critical Path Analysis

```python
class CriticalPathAnalysis:
    """Analyze and optimize development critical path."""
    
    def __init__(self, tasks, dependencies):
        self.tasks = tasks
        self.dependencies = dependencies
        self.graph = self.build_graph()
        
    def build_graph(self):
        """Build dependency graph."""
        graph = nx.DiGraph()
        
        for task in self.tasks:
            graph.add_node(task.id, 
                          duration=task.duration,
                          resources=task.resources,
                          risk=task.risk)
        
        for dep in self.dependencies:
            graph.add_edge(dep.from_task, dep.to_task, 
                          lag=dep.lag, 
                          type=dep.type)
        
        return graph
    
    def find_critical_path(self):
        """Find critical path using CPM."""
        # Calculate earliest start/finish
        for node in nx.topological_sort(self.graph):
            if len(list(self.graph.predecessors(node))) == 0:
                self.graph.nodes[node]['es'] = 0
                self.graph.nodes[node]['ef'] = self.graph.nodes[node]['duration']
            else:
                es = max(self.graph.nodes[pred]['ef'] + 
                        self.graph.edges[pred, node]['lag']
                        for pred in self.graph.predecessors(node))
                self.graph.nodes[node]['es'] = es
                self.graph.nodes[node]['ef'] = es + self.graph.nodes[node]['duration']
        
        # Calculate latest start/finish
        last_node = list(self.graph.nodes())[-1]
        project_duration = self.graph.nodes[last_node]['ef']
        
        for node in reversed(list(nx.topological_sort(self.graph))):
            if len(list(self.graph.successors(node))) == 0:
                self.graph.nodes[node]['lf'] = project_duration
                self.graph.nodes[node]['ls'] = project_duration - self.graph.nodes[node]['duration']
            else:
                lf = min(self.graph.nodes[succ]['ls'] - 
                        self.graph.edges[node, succ]['lag']
                        for succ in self.graph.successors(node))
                self.graph.nodes[node]['lf'] = lf
                self.graph.nodes[node]['ls'] = lf - self.graph.nodes[node]['duration']
        
        # Identify critical path
        critical_path = []
        for node in self.graph.nodes():
            if (self.graph.nodes[node]['ef'] == self.graph.nodes[node]['lf'] and
                self.graph.nodes[node]['es'] == self.graph.nodes[node]['ls']):
                critical_path.append(node)
        
        return critical_path, project_duration
    
    def optimize_critical_path(self):
        """Optimize critical path through task crashing."""
        critical_path, duration = self.find_critical_path()
        
        optimization_options = []
        for task in critical_path:
            # Analyze crash options for each critical task
            crash_options = self.analyze_crash_options(task)
            optimization_options.extend(crash_options)
        
        # Sort by cost-effectiveness (time saved per cost)
        optimization_options.sort(key=lambda x: x['time_saved'] / x['cost'])
        
        return optimization_options
