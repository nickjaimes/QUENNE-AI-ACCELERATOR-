        .CURRENT_MAX(500),  // uA
        .TRIM_BITS(4)
    ) u_cp (
        .up(up),
        .down(down),
        
        .out(cp_out),
        .current_setting(cp_current),
        
        .mismatch(mismatch),
        .leakage(leakage)
    );
    
    // Loop Filter
    loop_filter #(
        .C1(100),  // pF
        .C2(10),   // pF
        .R1(10),   // kOhm
        .TRIM_BITS(4)
    ) u_lf (
        .in(cp_out),
        .out(vctrl),
        
        .c1_trim(lf_capacitance[7:4]),
        .c2_trim(lf_capacitance[3:0]),
