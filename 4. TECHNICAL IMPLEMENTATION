class ScheduleRiskManager:
    """Manage schedule risks and critical path optimization."""
    
    def __init__(self, schedule, dependencies):
        self.schedule = schedule
        self.dependencies = dependencies
        self.critical_path = self.calculate_critical_path()
        
    def optimize_schedule(self):
        """Optimize schedule through task crashing."""
        optimizations = []
        
        for task in self.critical_path:
            crash_options = self.analyze_crash_options(task)
            optimizations.extend(crash_options)
        
        # Sort by cost-effectiveness
        optimizations.sort(key=lambda x: x['time_saved'] / x['cost'])
        
        # Apply optimizations within budget
        budget = 1000000  # $1M budget for crashing
        total_cost = 0
        total_time_saved = 0
        
        for opt in optimizations:
            if total_cost + opt['cost'] <= budget:
                self.apply_crash(opt['task'], opt['method'])
                total_cost += opt['cost']
                total_time_saved += opt['time_saved']
            else:
                break
        
        return total_time_saved, total_cost
    
    def analyze_crash_options(self, task):
        """Analyze options for crashing a task."""
        options = []
        
        # Option 1: Add more engineers
        if task['parallelizable']:
            new_duration = task['duration'] * (1 / math.log2(task['team_size'] + 1))
            time_saved = task['duration'] - new_duration
            cost = (task['team_size'] + 1) * task['cost_per_engineer'] * new_duration
            
            options.append({
                'task': task['id'],
                'method': 'add_engineers',
                'time_saved': time_saved,
                'cost': cost,
                'risk': 'low'
            })
        
        # Option 2: Overtime
        overtime_duration = task['duration'] * 0.7  # 30% reduction
        time_saved = task['duration'] - overtime_duration
        cost = task['team_size'] * task['cost_per_engineer'] * overtime_duration * 1.5
        
        options.append({
            'task': task['id'],
            'method': 'overtime',
            'time_saved': time_saved,
            'cost': cost,
            'risk': 'medium'
        })
        
        # Option 3: Better tools/automation
        if task['automation_potential'] > 0.5:
            automation_duration = task['duration'] * 0.6  # 40% reduction
            time_saved = task['duration'] - automation_duration
            cost = task['automation_cost']
            
            options.append({
                'task': task['id'],
                'method': 'automation',
                'time_saved': time_saved,
                'cost': cost,
                'risk': 'low'
            })
        
        return options
