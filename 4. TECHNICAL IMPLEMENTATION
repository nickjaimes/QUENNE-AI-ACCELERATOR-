// Reset network implementation
module reset_network #(
    parameter NUM_DOMAINS = 6,
    parameter DEASSERT_CYCLES = 1024,
    parameter SYNC_STAGES = 2,
    parameter WATCHDOG_ENABLE = 1
)(
    input  wire         clk,
    input  wire         rst_n,
    
    output wire         sys_rst_n,
    output wire         mem_rst_n,
    output wire         quantum_rst_n,
    output wire         neuro_rst_n,
    output wire         tpu_rst_n,
    output wire         noc_rst_n,
    
    // Configuration
    input  wire [31:0]  reset_config,
    input  wire         config_valid,
    output wire         config_ready,
    
    // Control
    input  wire [NUM_DOMAINS-1:0] reset_request,
    input  wire [NUM_DOMAINS-1:0] reset_hold,
    output wire [NUM_DOMAINS-1:0] reset_status,
    
    // Monitoring
    output wire [31:0]  reset_counters [NUM_DOMAINS-1:0],
    output wire [3:0]   reset_errors
);

    // Synchronize external reset
    logic [SYNC_STAGES-1:0] rst_n_sync;
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            rst_n_sync <= '0;
        end else begin
            rst_n_sync <= {rst_n_sync[SYNC_STAGES-2:0], 1'b1};
        end
    end
    
    wire global_rst_n = rst_n_sync[SYNC_STAGES-1];
    
    // Reset controller state machine
    enum logic [2:0] {
        RST_IDLE,
        RST_ASSERT,
        RST_HOLD,
        RST_DEASSERT,
        RST_WAIT,
        RST_ERROR
    } rst_state [NUM_DOMAINS-1:0];
    
    logic [23:0] rst_timer [NUM_DOMAINS-1:0];
    logic        rst_timeout [NUM_DOMAINS-1:0];
    
    // Reset generation for each domain
    generate
        for (genvar i = 0; i < NUM_DOMAINS; i++) begin : reset_domains
            // Reset state machine
            always_ff @(posedge clk or negedge global_rst_n) begin
                if (!global_rst_n) begin
                    rst_state[i] <= RST_IDLE;
                    rst_timer[i] <= 24'h0;
                    reset_counters[i] <= 32'h0;
                end else begin
                    case (rst_state[i])
                        RST_IDLE: begin
                            if (reset_request[i]) begin
                                rst_state[i] <= RST_ASSERT;
                                rst_timer[i] <= 24'h0;
                            end
                        end
                        
                        RST_ASSERT: begin
                            rst_timer[i] <= rst_timer[i] + 1;
                            if (rst_timer[i] >= reset_config[7:0]) begin
                                rst_state[i] <= RST_HOLD;
                                rst_timer[i] <= 24'h0;
                            end
                        end
                        
                        RST_HOLD: begin
                            rst_timer[i] <= rst_timer[i] + 1;
                            if (rst_timer[i] >= reset_config[15:8]) begin
                                if (reset_hold[i]) begin
                                    rst_state[i] <= RST_WAIT;
                                end else begin
                                    rst_state[i] <= RST_DEASSERT;
                                end
                                rst_timer[i] <= 24'h0;
                            end
                        end
                        
                        RST_DEASSERT: begin
                            rst_timer[i] <= rst_timer[i] + 1;
                            if (rst_timer[i] >= DEASSERT_CYCLES) begin
                                rst_state[i] <= RST_IDLE;
                                reset_counters[i] <= reset_counters[i] + 1;
                            end
                        end
                        
                        RST_WAIT: begin
                            if (!reset_hold[i]) begin
                                rst_state[i] <= RST_DEASSERT;
                                rst_timer[i] <= 24'h0;
                            end
                        end
                        
                        RST_ERROR: begin
                            // Error state - requires manual intervention
                            if (reset_config[31]) begin  // Error recovery bit
                                rst_state[i] <= RST_IDLE;
                            end
                        end
                    endcase
                    
                    // Timeout detection
                    rst_timeout[i] = (rst_timer[i] == 24'hFFFFFF);
                    if (rst_timeout[i] && rst_state[i] != RST_IDLE) begin
                        rst_state[i] <= RST_ERROR;
                    end
                end
            end
            
            // Reset output generation
            assign reset_outputs[i] = (rst_state[i] == RST_ASSERT) || 
                                     (rst_state[i] == RST_HOLD) || 
                                     (rst_state[i] == RST_WAIT);
            
            // Reset status
            assign reset_status[i] = (rst_state[i] == RST_IDLE);
        end
    endgenerate
    
    // Reset synchronization
    generate
        for (genvar i = 0; i < NUM_DOMAINS; i++) begin : reset_sync
            sync_reset #(
                .SYNC_STAGES(SYNC_STAGES)
            ) u_sync_reset (
                .clk(domain_clocks[i]),
                .async_rst_n(~reset_outputs[i]),
                .sync_rst_n(sync_reset_n[i])
            );
        end
    endgenerate
    
    // Reset output assignment
    assign sys_rst_n = sync_reset_n[0];
    assign mem_rst_n = sync_reset_n[1];
    assign quantum_rst_n = sync_reset_n[2];
    assign neuro_rst_n = sync_reset_n[3];
    assign tpu_rst_n = sync_reset_n[4];
    assign noc_rst_n = sync_reset_n[5];
    
    // Reset watchdog
    generate
        if (WATCHDOG_ENABLE) begin : watchdog
            reset_watchdog #(
                .NUM_DOMAINS(NUM_DOMAINS),
                .TIMEOUT_CYCLES(1000000)
            ) u_watchdog (
                .clk(clk),
                .rst_n(global_rst_n),
                
                .reset_states(rst_state),
                .reset_timers(rst_timer),
                
                .watchdog_timeout(watchdog_timeout),
                .watchdog_reset(watchdog_reset),
                .watchdog_irq(watchdog_irq)
            );
        end
    endgenerate
    
    // Reset error detection
    reset_error_detector #(
        .NUM_DOMAINS(NUM_DOMAINS)
    ) u_err_det (
        .clk(clk),
        .rst_n(global_rst_n),
        
        .reset_states(rst_state),
        .reset_timeouts(rst_timeout),
        .reset_outputs(reset_outputs),
        .reset_status(reset_status),
        
        .error_signals(reset_errors_raw),
        .error_counters(reset_error_counters)
    );
    
    // Reset configuration register
    always_ff @(posedge clk or negedge global_rst_n) begin
        if (!global_rst_n) begin
            reset_config_reg <= RESET_CONFIG_DEFAULT;
        end else if (config_valid && config_ready) begin
            reset_config_reg <= reset_config;
        end
    end
    
    // Reset pattern generator (for testing)
    reset_pattern_generator #(
        .NUM_PATTERNS(8),
        .PATTERN_LENGTH(16)
    ) u_pattern_gen (
        .clk(clk),
        .rst_n(global_rst_n),
        
        .pattern_enable(pattern_enable),
        .pattern_select(pattern_select),
        
        .reset_pattern(reset_pattern),
        .pattern_done(pattern_done)
    );
    
    // Reset power-on sequence
    power_on_reset #(
        .POWER_GOOD_DELAY(1000),
        .RESET_HOLD_TIME(100)
    ) u_por (
        .clk(clk),
        .power_good(power_good),
        
        .por_reset_n(por_reset_n),
        .por_done(por_done)
    );
    
    // Reset isolation control
    reset_isolation #(
        .NUM_DOMAINS(NUM_DOMAINS)
    ) u_iso (
        .clk(clk),
        .rst_n(global_rst_n),
        
        .reset_outputs(reset_outputs),
        .iso_enable(iso_enable),
        
        .iso_reset_n(iso_reset_n),
        .iso_status(iso_status)
    );

endmodule
