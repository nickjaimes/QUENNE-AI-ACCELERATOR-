// Clock distribution network implementation
module clock_network #(
    parameter NUM_DOMAINS = 5,
    parameter NUM_PLLS = 3,
    parameter NUM_FREQ_STEPS = 8,
    parameter CLOCK_WIDTH = 1
)(
    input  wire                         ref_clk_400mhz,
    input  wire                         ref_clk_200mhz,
    input  wire                         ref_clk_100mhz,
    input  wire                         rst_n,
    
    output wire                         sys_clk,
    output wire                         mem_clk,
    output wire                         quantum_clk,
    output wire                         neuro_clk,
    output wire                         tpu_clk,
    output wire                         pll_lock,
    
    // Configuration interface
    input  wire [31:0]                  clk_config,
    input  wire                         clk_config_valid,
    output wire                         clk_config_ready,
    
    // Status outputs
    output wire [31:0]                  clk_status,
    output wire [15:0]                  clk_freq [NUM_DOMAINS-1:0],
    output wire                         clk_stable,
    output wire [3:0]                   clk_errors
);

    // PLL instances
    generate
        for (genvar i = 0; i < NUM_PLLS; i++) begin : plls
            pll_wrapper #(
                .INPUT_FREQ(400),  // MHz
                .OUTPUT_FREQ_MIN(50),
                .OUTPUT_FREQ_MAX(800),
                .NUM_OUTPUTS(2)
            ) u_pll (
                .refclk(ref_clk_400mhz),
                .rst_n(rst_n & pll_reset_n[i]),
                
                .outclk(pll_clk[i]),
                .locked(pll_locked[i]),
                
                .config(pll_config[i]),
                .config_valid(pll_config_valid[i]),
                .config_ready(pll_config_ready[i])
            );
        end
    endgenerate
    
    // Clock multiplexers for each domain
    generate
        for (genvar i = 0; i < NUM_DOMAINS; i++) begin : clock_muxes
            clock_mux #(
                .NUM_INPUTS(4),
                .GLITCH_FREE(1)
            ) u_clk_mux (
                .clk_in(clk_mux_inputs[i]),
                .clk_out(clk_mux_outputs[i]),
                .sel(clk_mux_sel[i]),
                .switch_en(clk_mux_switch_en[i]),
                .switch_done(clk_mux_switch_done[i])
            );
        end
    endgenerate
    
    // Clock dividers
    generate
        for (genvar i = 0; i < NUM_DOMAINS; i++) begin : clock_dividers
            clock_divider #(
                .MAX_DIV(64),
                .DUTY_CYCLE(50)
            ) u_clk_div (
                .clk_in(clk_mux_outputs[i]),
                .rst_n(rst_n),
                
                .clk_out(clk_div_outputs[i]),
                .div_ratio(clk_div_ratio[i]),
                .div_valid(clk_div_valid[i]),
                .div_ready(clk_div_ready[i])
            );
        end
    endgenerate
    
    // Clock gating cells
    generate
        for (genvar i = 0; i < NUM_DOMAINS; i++) begin : clock_gates
            clock_gate #(
                .LATCH_BASED(1)
            ) u_clk_gate (
                .clk_in(clk_div_outputs[i]),
                .clk_out(clk_gate_outputs[i]),
                .gate_en(clk_gate_en[i]),
                .gate_async(clk_gate_async[i])
            );
        end
    endgenerate
    
    // Clock monitors
    generate
        for (genvar i = 0; i < NUM_DOMAINS; i++) begin : clock_monitors
            clock_monitor #(
                .REF_CLK_FREQ(100)  // MHz
            ) u_clk_mon (
                .clk_in(clk_gate_outputs[i]),
                .ref_clk(ref_clk_100mhz),
                .rst_n(rst_n),
                
                .freq_measured(clk_freq[i]),
                .freq_valid(freq_valid[i]),
                .freq_error(freq_error[i]),
                .clock_stable(clock_stable[i])
            );
        end
    endgenerate
    
    // Clock controller state machine
    enum logic [2:0] {
        CLK_INIT,
        CLK_PLL_LOCK,
        CLK_DISTRIBUTE,
        CLK_CALIBRATE,
        CLK_OPERATIONAL,
        CLK_ADJUST,
        CLK_ERROR
    } clk_state, clk_next_state;
    
    logic [23:0] init_timer;
    logic        init_timeout;
    
    always_ff @(posedge ref_clk_100mhz or negedge rst_n) begin
        if (!rst_n) begin
            clk_state <= CLK_INIT;
            init_timer <= 24'h0;
        end else begin
            clk_state <= clk_next_state;
            
            if (clk_state == CLK_INIT) begin
                init_timer <= init_timer + 1;
            end else begin
                init_timer <= 24'h0;
            end
        end
    end
    
    always_comb begin
        clk_next_state = clk_state;
        init_timeout = (init_timer == 24'hFFFFFF);
        
        case (clk_state)
            CLK_INIT: begin
                if (init_timeout) begin
                    clk_next_state = CLK_PLL_LOCK;
                end
            end
            
            CLK_PLL_LOCK: begin
                if (&pll_locked) begin
                    clk_next_state = CLK_DISTRIBUTE;
                end else if (init_timeout) begin
                    clk_next_state = CLK_ERROR;
                end
            end
            
            CLK_DISTRIBUTE: begin
                // Configure clock distribution
                clk_mux_sel = clock_config.sel;
                clk_div_ratio = clock_config.div;
                clk_gate_en = clock_config.gate;
                
                if (clk_config_valid && clk_config_ready) begin
                    clk_next_state = CLK_CALIBRATE;
                end
            end
            
            CLK_CALIBRATE: begin
                // Wait for clock monitors to stabilize
                if (&clock_stable) begin
                    clk_next_state = CLK_OPERATIONAL;
                end else if (init_timeout) begin
                    clk_next_state = CLK_ERROR;
                end
            end
            
            CLK_OPERATIONAL: begin
                if (clk_config_valid && clk_config_ready) begin
                    // Dynamic clock adjustment
                    clk_next_state = CLK_ADJUST;
                end else if (|freq_error) begin
                    clk_next_state = CLK_ERROR;
                end
            end
            
            CLK_ADJUST: begin
                // Perform clock adjustment
                if (clk_mux_switch_done && clk_div_ready) begin
                    clk_next_state = CLK_CALIBRATE;
                end
            end
            
            CLK_ERROR: begin
                // Error recovery
                if (clk_config.recovery) begin
                    clk_next_state = CLK_INIT;
                end
            end
        endcase
    end
    
    // Clock configuration register
    always_ff @(posedge ref_clk_100mhz or negedge rst_n) begin
        if (!rst_n) begin
            clock_config <= CLK_CONFIG_DEFAULT;
        end else if (clk_config_valid && clk_config_ready) begin
            clock_config <= clk_config;
        end
    end
    
    // Output clock assignment
    assign sys_clk = clk_gate_outputs[0];
    assign mem_clk = clk_gate_outputs[1];
    assign quantum_clk = clk_gate_outputs[2];
    assign neuro_clk = clk_gate_outputs[3];
    assign tpu_clk = clk_gate_outputs[4];
    
    // Status outputs
    assign pll_lock = &pll_locked;
    assign clk_stable = &clock_stable;
    
    always_comb begin
        clk_status = {
            8'h00,  // Reserved
            clk_errors,
            4'h0,   // Reserved
            clk_state,
            pll_locked,
            clock_stable
        };
    end
    
    // Error detection and logging
    always_ff @(posedge ref_clk_100mhz or negedge rst_n) begin
        if (!rst_n) begin
            clk_errors <= 4'h0;
            error_log <= '{default: '0};
        end else begin
            // Detect PLL unlock
            if (|(~pll_locked & pll_locked_d1)) begin
                clk_errors[0] <= 1'b1;
                error_log[0] <= {8'h01, pll_locked, 16'h0};
            end
            
            // Detect frequency error
            if (|freq_error) begin
                clk_errors[1] <= 1'b1;
                for (int i = 0; i < NUM_DOMAINS; i++) begin
                    if (freq_error[i]) begin
                        error_log[1+i] <= {8'h02, 8'h00, clk_freq[i]};
                    end
                end
            end
            
            // Detect clock stoppage
            for (int i = 0; i < NUM_DOMAINS; i++) begin
                if (clock_stable_d1[i] && !clock_stable[i]) begin
                    clk_errors[2] <= 1'b1;
                    error_log[8+i] <= {8'h03, 8'h00, 8'h00, i};
                end
            end
            
            // Store previous values
            pll_locked_d1 <= pll_locked;
            clock_stable_d1 <= clock_stable;
        end
    end
    
    // Clock skew adjustment
    clock_skew_adjuster #(
        .NUM_DOMAINS(NUM_DOMAINS),
        .MAX_SKEW(32),
        .STEP_SIZE(1)
    ) u_skew_adj (
        .clk_in(clk_mux_outputs),
        .clk_out(clk_skew_adjusted),
        .rst_n(rst_n),
        
        .skew_control(skew_control),
        .skew_valid(skew_valid),
        .skew_ready(skew_ready),
        
        .skew_measured(skew_measured),
        .skew_valid_out(skew_valid_out)
    );
    
    // Clock jitter measurement
    clock_jitter_measurer #(
        .NUM_DOMAINS(NUM_DOMAINS)
    ) u_jitter_meas (
        .clk_in(clk_gate_outputs),
        .ref_clk(ref_clk_100mhz),
        .rst_n(rst_n),
        
        .jitter_rms(jitter_rms),
        .jitter_peak(jitter_peak),
        .jitter_valid(jitter_valid)
    );

endmodule
