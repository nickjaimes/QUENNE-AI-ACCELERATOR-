        .freq_valid(freq_valid),
        
        .vco_sel_out(cal_vco_sel),
        .cp_current_out(cal_cp_current),
        .lf_settings_out(cal_lf_settings),
        .div_ratio_out(cal_div_ratio),
        
        .cal_done(cal_done),
        .cal_success(cal_success)
    );
    
    // Spread spectrum modulation (optional)
    ssc_generator #(
        .MODULATION_RATE(30),   // kHz
        .MODULATION_DEPTH(1),   // 1%
        .MODULATION_TYPE("CENTER")
    ) u_ssc (
        .clk(refclk),
        .rst_n(rst_n),
        
        .mod_enable(ssc_enable),
        .mod_out(ssc_mod),
        
        .mod_depth(ssc_depth),
        .mod_rate(ssc_rate)
    );
    
    // Power management
    pll_power_mgmt #(
        .POWER_DOWN_DELAY(100),  // cycles
        .POWER_UP_DELAY(1000)    // cycles
    ) u_pwr_mgmt (
        .clk(refclk),
