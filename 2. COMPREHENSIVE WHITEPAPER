   ```python
   class STDP:
       def __init__(self, A_plus=0.01, A_minus=0.01, tau_plus=20.0, tau_minus=20.0):
           self.A_plus = A_plus
           self.A_minus = A_minus
           self.tau_plus = tau_plus
           self.tau_minus = tau_minus
           
       def update(self, pre_spike, post_spike, dt):
           if pre_spike and post_spike:
               # Pre before post: LTP
               delta_w = self.A_plus * np.exp(-dt / self.tau_plus)
           elif post_spike and pre_spike:
               # Post before pre: LTD
               delta_w = -self.A_minus * np.exp(-dt / self.tau_minus)
           else:
               delta_w = 0.0
               
           return delta_w
