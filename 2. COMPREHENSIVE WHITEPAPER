        pruned_model = self.pruner.prune(
            quantized_model,
            sparsity_target=0.9,
            importance_metric='magnitude'
        )
        
        # Step 3: Hardware-aware optimization
        click.echo("Step 3: Hardware-aware optimization...")
        hardware_optimized = self.hardware_mapper.map(
            pruned_model,
            hardware=target_hardware,
            optimization_level='aggressive'
        )
        
        # Step 4: Compilation
        click.echo("Step 4: Compiling for target hardware...")
        compiled_model = self.compiler.compile(
            hardware_optimized,
            target=target_hardware
        )
        
        return compiled_model
    
    def evaluate(self, original_model, optimized_model, dataset):
        """Evaluate optimization results."""
        
        original_metrics = self.evaluate_model(original_model, dataset)
        optimized_metrics = self.evaluate_model(optimized_model, dataset)
        
        return {
            'original': original_metrics,
            'optimized': optimized_metrics,
            'improvement': {
                'speedup': optimized_metrics['throughput'] / original_metrics['throughput'],
                'energy_improvement': original_metrics['energy'] / optimized_metrics['energy'],
                'memory_reduction': original_metrics['memory'] / optimized_metrics['memory'],
                'accuracy_change': optimized_metrics['accuracy'] - original_metrics['accuracy']
            }
        }
