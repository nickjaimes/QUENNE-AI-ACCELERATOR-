import numpy as np
from dataclasses import dataclass
from typing import List, Tuple, Optional

@dataclass
class LIFNeuron:
    """Leaky Integrate-and-Fire neuron model."""
    membrane_potential: float = 0.0
    threshold: float = 1.0
    decay_rate: float = 0.9
    refractory_period: int = 2
    refractory_counter: int = 0
    
    def update(self, input_current: float) -> bool:
        """Update neuron state and return if it fired."""
        if self.refractory_counter > 0:
            self.refractory_counter -= 1
            self.membrane_potential = 0.0
            return False
        
        # Update membrane potential
        self.membrane_potential = (
            self.decay_rate * self.membrane_potential + input_current
        )
        
        # Check for spike
        if self.membrane_potential >= self.threshold:
            self.membrane_potential = 0.0
            self.refractory_counter = self.refractory_period
            return True
        
        return False

class SpikingAttention:
    """Spiking neural network attention mechanism."""
    
    def __init__(self, num_neurons: int, num_timesteps: int = 10):
        self.num_neurons = num_neurons
        self.num_timesteps = num_timesteps
        
        # Initialize neurons
        self.query_neurons = [LIFNeuron() for _ in range(num_neurons)]
        self.key_neurons = [LIFNeuron() for _ in range(num_neurons)]
        self.value_neurons = [LIFNeuron() for _ in range(num_neurons)]
        
        # Synaptic weights
        self.weights_qk = np.random.randn(num_neurons, num_neurons) * 0.1
        self.weights_v = np.random.randn(num_neurons, num_neurons) * 0.1
        
    def encode_spikes(self, data: np.ndarray) -> np.ndarray:
        """Encode continuous data into spike trains."""
        spike_trains = np.zeros((self.num_timesteps, self.num_neurons))
        
        for t in range(self.num_timesteps):
            # Temporal coding: fire if data exceeds time-varying threshold
            threshold = (t + 1) / self.num_timesteps
            spike_trains[t] = (data > threshold).astype(float)
        
        return spike_trains
    
    def compute_attention(self, 
                         query: np.ndarray, 
                         key: np.ndarray, 
                         value: np.ndarray) -> np.ndarray:
        """Compute spiking attention."""
        # Encode inputs into spike trains
        query_spikes = self.encode_spikes(query)
        key_spikes = self.encode_spikes(key)
        value_spikes = self.encode_spikes(value)
        
        # Initialize output
        output_spikes = np.zeros((self.num_timesteps, self.num_neurons))
        
        # Simulate spiking network over time
        for t in range(self.num_timesteps):
            # Update query neurons
            for i in range(self.num_neurons):
                input_current = query_spikes[t, i]
                if self.query_neurons[i].update(input_current):
                    # Query neuron fired, stimulate key neurons
                    for j in range(self.num_neurons):
                        current = self.weights_qk[i, j]
                        self.key_neurons[j].membrane_potential += current
            
            # Update key neurons
            for j in range(self.num_neurons):
                input_current = key_spikes[t, j]
                if self.key_neurons[j].update(input_current):
                    # Key neuron fired, compute attention weight
                    attention = self.compute_attention_weight(i, j)
                    
                    # Stimulate value neurons based on attention
                    for k in range(self.num_neurons):
                        current = attention * self.weights_v[j, k]
                        self.value_neurons[k].membrane_potential += current
            
            # Update value neurons
            for k in range(self.num_neurons):
                input_current = value_spikes[t, k]
                if self.value_neurons[k].update(input_current):
                    output_spikes[t, k] = 1.0
        
        # Decode output spikes
        output = self.decode_spikes(output_spikes)
        return output
    
    def compute_attention_weight(self, query_idx: int, key_idx: int) -> float:
        """Compute attention weight between query and key neurons."""
        # Simplified dot-product attention
        weight = np.dot(self.weights_qk[query_idx], self.weights_qk[key_idx])
        return np.exp(weight) / np.sum(np.exp(self.weights_qk[query_idx]))
    
    def decode_spikes(self, spike_trains: np.ndarray) -> np.ndarray:
        """Decode spike trains back to continuous values."""
        # Rate coding: firing rate represents value
        firing_rates = np.mean(spike_trains, axis=0)
        return firing_rates
